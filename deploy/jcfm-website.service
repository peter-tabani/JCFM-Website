[Unit]
Description=JCFM Website (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/jcfm
# Runs next directly (not `npm run start`) so systemd tracks the real
# Node process and SIGTERM/restart/stop behave correctly.
ExecStart=/usr/bin/env node node_modules/.bin/next start -p 3000
EnvironmentFile=/var/www/jcfm/.env
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5

# Light sandboxing — safe defaults for a stateless Node web app.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
