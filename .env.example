# ─────────────────────────────────────────────────────────────
# JCFM Website — environment variables
# Copy this file to .env.local (or .env) and fill in real values.
# NEVER commit real secrets. .env* is gitignored.
# Full instructions: docs/PAYMENTS_SETUP.md
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──
# Managed Postgres connection string (e.g. Neon, Supabase, Vercel Postgres).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/jcfm?schema=public"

# ── NextAuth ──
# Generate a strong secret:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# The canonical URL of the site (used for callbacks). Localhost in dev.
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional sign-in) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── IntaSend (M-Pesa + card + Google Pay) ──
# The single payment gateway. Get keys from your IntaSend dashboard
# (dashboard.intasend.com) under Settings -> API Keys & Wallets.
# The PUBLISHABLE key ships to the browser (that's why it's NEXT_PUBLIC_);
# it is safe to expose. Test with sandbox keys first, then switch to live.
NEXT_PUBLIC_INTASEND_PUBLISHABLE_KEY="ISPubKey_test_xxx"
# "sandbox" (test money) or "live" (real money).
NEXT_PUBLIC_INTASEND_MODE="sandbox"
# A secret challenge string you set on the IntaSend webhook (Settings ->
# Webhooks). The webhook rejects any request whose challenge doesn't match.
INTASEND_WEBHOOK_CHALLENGE="pick-a-long-random-string"

# ── Base URL used by server code to build absolute links ──
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
