# ─────────────────────────────────────────────────────────────
# JCFM Website — environment variables
# Copy this file to .env.local (or .env) and fill in real values.
# NEVER commit real secrets. .env* is gitignored.
# Full instructions: docs/PAYMENTS_SETUP.md
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──
# Managed Postgres connection string (e.g. Neon, Supabase, Vercel Postgres).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/jcfm?schema=public"

# ── NextAuth ──
# Generate a strong secret:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# The canonical URL of the site (used for callbacks). Localhost in dev.
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional sign-in) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe (cards + Cash App Pay) ──
# TEST keys start with sk_test_ / pk_test_. Switch to live keys to go live.
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From the Stripe webhook endpoint you register (starts with whsec_).
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── PayPal ──
# Sandbox credentials from developer.paypal.com. Switch to live to go live.
PAYPAL_CLIENT_ID="xxx"
PAYPAL_CLIENT_SECRET="xxx"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="xxx"
# "sandbox" (test) or "live" (production).
PAYPAL_ENV="sandbox"
# PayPal webhook id, created when you register the webhook in the dashboard.
PAYPAL_WEBHOOK_ID="xxx"

# ── Base URL used by server code to build absolute links ──
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
