// Prisma schema for JCFM donations + accounts.
// Datasource: PostgreSQL (paste your connection string into DATABASE_URL).
// See docs/PAYMENTS_SETUP.md for setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum DonationStatus {
  pending
  succeeded
  failed
}

enum PaymentProvider {
  stripe
  paypal
}

enum SermonStatus {
  published
  draft
  scheduled
}

enum MemberStatus {
  active
  visitor
  inactive
}

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  // bcrypt hash. Null for accounts created via OAuth (Google) only.
  passwordHash String?
  phone        String?
  role         Role       @default(user)
  image        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  donations    Donation[]
}

model Sermon {
  id        String       @id @default(cuid())
  title     String
  series    String?
  preacher  String
  branch    String?
  date      DateTime?
  status    SermonStatus @default(published)
  mediaUrl  String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, date])
}

model Member {
  id        String       @id @default(cuid())
  name      String
  branch    String
  role      String       @default("Member")
  phone     String?
  email     String?
  status    MemberStatus @default(active)
  joinedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([branch])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  date        DateTime?
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, date])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  tag       String?
  bio       String
  quote     String?
  photo     String?
  email     String?
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Donation {
  id           String          @id @default(cuid())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  // Amount in the smallest currency unit (cents). Always validated server-side.
  amountCents  Int
  currency     String          @default("usd")
  provider     PaymentProvider
  // Stripe PaymentIntent id or PayPal order/capture id. Unique to prevent
  // duplicate fulfilment from repeated webhook deliveries.
  providerRef  String          @unique
  status       DonationStatus  @default(pending)
  // Project slug from data/donor.ts, or "general" for the general fund.
  designation  String          @default("general")
  // Human-readable snapshot of what was supported, stored at creation time
  // so history stays correct even if project content later changes.
  designationLabel String
  receiptEmail String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, createdAt])
}
